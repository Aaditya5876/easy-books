generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  STAFF
  TEACHER
  LIBRARIAN
}

enum PortalUserType {
  PARENT
  STUDENT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum PayrollStatus {
  PENDING
  PROCESSED
  PAID
  ON_HOLD
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  QR
  CREDIT
}

enum TransactionType {
  CASH
  BANK
  WALLET // eSewa, Khalti, or any other digital wallet not yet settled to a bank account
  CHEQUE
  CREDIT
}

enum TransactionCategory {
  INCOME
  EXPENSE
  TRANSFER
  INVESTMENT
  HAND_OUTS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Which Cash Flow Statement section a non-cash account's movements belong to
// (see ReportsService.getCashFlowStatement) — e.g. Fixed Assets = INVESTING.
// Left unset on an account and the report falls back to a sensible default
// (EQUITY -> FINANCING, everything else -> OPERATING).
enum CashFlowActivity {
  OPERATING
  INVESTING
  FINANCING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_PAID
  COMPLETED
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum QuotationRemark {
  QUOTED
  WORK_DONE
  CANCELLED
  REVISED
  BILLED
}

enum QuotationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChequeStatus {
  ISSUED
  DEPOSITED
  CLEARED
  BOUNCED
  CANCELLED
}

enum BankGuaranteeStatus {
  ACTIVE
  EXPIRED
  CLAIMED
  RELEASED
}

enum CreditNoteStatus {
  OPEN
  APPLIED
  CLOSED
}

enum NotificationType {
  LOW_STOCK
  FEE_PAYMENT
  LEAVE_REQUEST
  PAYROLL_PAID
  SYSTEM_AUTOMATION
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  role               UserRole  @default(STAFF)
  refreshToken       String?
  emailVerified      Boolean   @default(false)
  verificationOtp    String?
  otpExpiresAt       DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userCompanies UserCompany[]
  notifications Notification[]

  @@map("users")
}

model Company {
  id                 String   @id @default(uuid())
  name               String
  abbreviation       String?
  address            String?
  phone              String?
  email              String?
  panVat             String?
  registrationNumber String?
  logoUrl            String?
  currency           String   @default("NPR")
  fiscalYearStart    String?
  businessType       String? // "pharmacy", "tea-shop", "clothes", "bakery", etc.
  defaultUnitType    String? // "pcs", "meter", "tablet", "strip", "bottle", etc.
  isVatRegistered    Boolean  @default(false)
  vatSubmissionFreq  String? // "MONTHLY" | "TRIMESTERLY"
  isActive           Boolean  @default(true)
  // Auto-increment counters for invoice numbering (reset each fiscal year)
  invoiceSequence    Int      @default(0)
  purchaseSequence   Int      @default(0)
  quotationSequence  Int      @default(0)
  creditNoteSequence Int      @default(0)
  debitNoteSequence  Int      @default(0)
  sequenceFiscalYear String? // tracks fiscal year for sequence reset, e.g. "2081-82"
  feeReceiptSequence Int      @default(0)
  feeReceiptYear     String? // BS year the receipt sequence belongs to, e.g. "2083"
  // Which optional shared modules this company's plan includes, e.g.
  // ["FINANCE", "HRMS", "COMMUNICATION", "INVENTORY", "AI", "BULK_IMPORT"].
  // Empty = unrestricted (legacy/full-access) — enforced by ModuleAccessGuard,
  // only once a company has actually been scoped to a specific module set.
  enabledModules     String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userCompanies        UserCompany[]
  employees            Employee[]
  attendance           Attendance[]
  payrolls             Payroll[]
  bankAccounts         BankAccount[]
  transactions         Transaction[]
  ledgerAccounts       LedgerAccount[]
  ledgerEntries        LedgerEntry[]
  inventoryItems       InventoryItem[]
  salesOrders          SalesOrder[]
  purchaseOrders       PurchaseOrder[]
  payments             Payment[]
  creditNotes          CreditNote[]
  debitNotes           DebitNote[]
  clients              Client[]
  vendors              Vendor[]
  quotations           Quotation[]
  memoDocs             MemoDocument[]
  tasks                Task[]
  leaveTypes           LeaveType[]
  cheques              Cheque[]
  bankGuarantees       BankGuarantee[]
  pettyCashVouchers    PettyCashVoucher[]
  fixedAssets          FixedAsset[]
  payrollSettings      CompanyPayrollSettings?
  inventoryAdjustments InventoryAdjustment[]
  schoolClasses        SchoolClass[]
  students             Student[]
  subjects             Subject[]
  feeStructures        FeeStructure[]
  feeInvoices          FeeInvoice[]
  examResults          ExamResult[]
  exams                Exam[]
  academicYears        AcademicYear[]
  studentAttendances   StudentAttendance[]
  timetableEntries     TimetableEntry[]
  schoolNotices        SchoolNotice[]
  schoolEvents         SchoolEvent[]
  studyMaterials       StudyMaterial[]
  homeworks            Homework[]
  books                Book[]
  bookIssues           BookIssue[]
  hostelRooms          HostelRoom[]
  hostelAllocations    HostelAllocation[]
  transportRoutes      TransportRoute[]
  studentTransports    StudentTransport[]
  portalUsers          PortalUser[]
  examSchedules        ExamSchedule[]
  feeHeads             FeeHead[]
  feePayments          FeePayment[]
  studentScholarships  StudentScholarship[]
  feePackages          FeePackage[]
  notifications        Notification[]
  portalNotifications  PortalNotification[]

  @@map("companies")
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@map("user_companies")
}

model CompanyPayrollSettings {
  id                     String   @id @default(uuid())
  companyId              String   @unique
  company                Company  @relation(fields: [companyId], references: [id])
  ssfApplicable          Boolean  @default(true)
  ssfEmployeeRate        Decimal  @default(11) @db.Decimal(5, 2) // % of basic
  ssfEmployerRate        Decimal  @default(20) @db.Decimal(5, 2) // % of basic
  pitApplicable          Boolean  @default(true)
  dashainBonusApplicable Boolean  @default(true)
  dashainBonusMonth      String? // "kartik" or specific BS month name
  workingDaysPerMonth    Int      @default(26)
  overtimeRatePerHour    Decimal  @default(0) @db.Decimal(8, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("company_payroll_settings")
}

model Employee {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  name          String
  employeeId    String
  department    String?
  designation   String?
  phone         String?
  email         String?
  address       String?
  panNumber     String?
  dateOfJoining DateTime?
  basicSalary   Decimal        @default(0) @db.Decimal(12, 2)
  allowances    Json? // { "transport": 2000, "food": 1500, ... }
  bankName      String?
  bankAccount   String?
  status        EmployeeStatus @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  attendance    Attendance[]
  payrolls      Payroll[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([companyId, employeeId])
  @@map("employees")
}

model Attendance {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  date          DateTime
  status        AttendanceStatus
  checkInTime   String?
  checkOutTime  String?
  overtimeHours Decimal          @default(0) @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
  @@map("attendance")
}

model LeaveType {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String // "Annual Leave", "Sick Leave", "Maternity Leave"
  daysPerYear Decimal  @default(0) @db.Decimal(5, 1)
  isPaid      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(uuid())
  companyId     String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  fiscalYear    String
  totalDays     Decimal   @default(0) @db.Decimal(5, 1)
  usedDays      Decimal   @default(0) @db.Decimal(5, 1)
  remainingDays Decimal   @default(0) @db.Decimal(5, 1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, fiscalYear])
  @@map("leave_balances")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  companyId   String
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  totalDays   Decimal     @db.Decimal(5, 1)
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
}

model Payroll {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  month           String // "2081-01" (BS year-month)
  basicSalary     Decimal       @db.Decimal(12, 2)
  allowances      Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal       @db.Decimal(12, 2)
  absentDays      Decimal       @default(0) @db.Decimal(5, 1)
  halfDays        Decimal       @default(0) @db.Decimal(5, 1)
  absentDeduction Decimal       @default(0) @db.Decimal(12, 2)
  overtimeAmount  Decimal       @default(0) @db.Decimal(12, 2)
  ssfEmployee     Decimal       @default(0) @db.Decimal(12, 2)
  ssfEmployer     Decimal       @default(0) @db.Decimal(12, 2)
  pit             Decimal       @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2)
  netSalary       Decimal       @db.Decimal(12, 2)
  isDashainBonus  Boolean       @default(false)
  isOnHold        Boolean       @default(false)
  holdReason      String?
  status          PayrollStatus @default(PENDING)
  processedAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([employeeId, month])
  @@map("payrolls")
}

model BankAccount {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  bankName       String
  accountNumber  String
  accountType    String?
  branch         String?
  currentBalance Decimal  @default(0) @db.Decimal(14, 2)
  portalUrl      String?
  qrCodeUrl      String? // scan-to-pay QR image (eSewa/Khalti/bank QR) shown to payers, e.g. in the parent portal
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions Transaction[]
  cheques      Cheque[]
  feePayments  FeePayment[]

  @@map("bank_accounts")
}

model Transaction {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?        @relation(fields: [bankAccountId], references: [id])
  // Every transaction is a balanced double-entry: debitAccount/creditAccount are
  // LedgerAccount rows, and creating a Transaction always posts a matching pair of
  // LedgerEntry rows (see LedgerPostingService.postManualJournalEntryTx). Nullable
  // only so pre-existing rows created before this field existed don't break.
  debitAccountId  String?
  debitAccount    LedgerAccount?      @relation("TransactionDebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount   LedgerAccount?      @relation("TransactionCreditAccount", fields: [creditAccountId], references: [id])
  // A matched/created vendor or customer Ledger account — tracked via a separate
  // single-sided memo entry (LedgerPostingService.postPartyLedgerLineTx), never one
  // of the two balanced legs above. Persisted here (not just passed through the
  // DTO) so status updates later (cancel/un-cancel, amount edits) know which
  // party account to reverse/re-post without needing it resupplied by the caller.
  partyAccountId  String?
  partyAccount    LedgerAccount?      @relation("TransactionPartyAccount", fields: [partyAccountId], references: [id])
  dateAd          DateTime
  dateBs          String?
  type            TransactionType
  category        TransactionCategory
  amount          Decimal             @db.Decimal(14, 2)
  description     String?
  partyName       String?
  reference       String?
  referenceType   String? // "SALES_ORDER" | "PURCHASE_ORDER" | "PAYROLL" | "MANUAL"
  referenceId     String?
  status          TransactionStatus   @default(COMPLETED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("transactions")
}

model Cheque {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  chequeNumber  String
  partyName     String
  amount        Decimal      @db.Decimal(14, 2)
  dateAd        DateTime
  dateBs        String?
  isReceivable  Boolean      @default(false) // true = we received it, false = we issued it
  status        ChequeStatus @default(ISSUED)
  referenceType String?
  referenceId   String?
  notes         String?
  clearedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("cheques")
}

model BankGuarantee {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  bgNumber     String
  partyName    String
  bankName     String
  amount       Decimal             @db.Decimal(14, 2)
  issuedDateAd DateTime
  issuedDateBs String?
  expiryDateAd DateTime
  expiryDateBs String?
  purpose      String?
  status       BankGuaranteeStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("bank_guarantees")
}

model PettyCashVoucher {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  voucherNo   String
  dateAd      DateTime
  dateBs      String?
  amount      Decimal  @db.Decimal(10, 2)
  description String
  category    String?
  paidTo      String?
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("petty_cash_vouchers")
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

// Individual assets tracked here for depreciation math (cost, useful life,
// accumulated depreciation per asset) — the actual ledger postings share two
// company-wide system accounts ("Fixed Assets", "Accumulated Depreciation"),
// the same pattern Payroll uses (per-employee records, shared Salary Expense
// account), rather than one ledger account per asset.
model FixedAsset {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id])
  assetName              String
  assetCode              String?
  category               String?
  purchaseDateAd         DateTime
  purchaseDateBs         String?
  cost                   Decimal          @db.Decimal(14, 2)
  usefulLifeYears        Int
  salvageValue           Decimal          @default(0) @db.Decimal(14, 2)
  accumulatedDepreciation Decimal         @default(0) @db.Decimal(14, 2)
  lastDepreciationDateAd DateTime?
  status                 FixedAssetStatus @default(ACTIVE)
  disposalDateAd         DateTime?
  disposalAmount         Decimal?         @db.Decimal(14, 2)
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt               DateTime        @updatedAt

  @@map("fixed_assets")
}

model LedgerAccount {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  accountName    String
  accountCode    String?
  accountType    LedgerAccountType
  contactId      String? // clientId or vendorId
  contactType    String? // "CLIENT" | "VENDOR"
  openingBalance Decimal           @default(0) @db.Decimal(14, 2)
  currentBalance Decimal           @default(0) @db.Decimal(14, 2)
  fiscalYear     String?
  isSystem       Boolean           @default(false)
  isHidden       Boolean           @default(false)
  cashFlowActivity CashFlowActivity?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  entries LedgerEntry[]
  debitTransactions  Transaction[] @relation("TransactionDebitAccount")
  creditTransactions Transaction[] @relation("TransactionCreditAccount")
  partyTransactions  Transaction[] @relation("TransactionPartyAccount")

  @@unique([companyId, accountCode])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  accountId     String
  account       LedgerAccount @relation(fields: [accountId], references: [id])
  dateAd        DateTime
  dateBs        String?
  description   String?
  debit         Decimal       @default(0) @db.Decimal(14, 2)
  credit        Decimal       @default(0) @db.Decimal(14, 2)
  balance       Decimal       @default(0) @db.Decimal(14, 2)
  referenceType String? // "SALES_ORDER" | "PURCHASE_ORDER" | "PAYMENT" | "PAYROLL"
  referenceId   String?
  isAutoPosted  Boolean       @default(false)
  isLocked      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("ledger_entries")
}

model InventoryItem {
  id                     String    @id @default(uuid())
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id])
  partNumber             String?
  itemName               String?
  brand                  String?
  modelNo                String?
  description            String?
  application            String?
  imageUrl               String?
  quantity               Decimal   @default(0) @db.Decimal(12, 3)
  unit                   String    @default("PCS") // free text — PCS, SET, KG, LTR, etc.
  unitPurchasePrice      Decimal   @default(0) @db.Decimal(12, 2) // last purchase price
  unitSellingPrice       Decimal   @default(0) @db.Decimal(12, 2)
  defaultDiscountPercent Decimal   @default(0) @db.Decimal(5, 2)
  stockLocation          String?
  lowStockThreshold      Decimal   @default(0) @db.Decimal(12, 3)
  agingDays              Int?
  vendorId               String?
  vendor                 Vendor?   @relation(fields: [vendorId], references: [id])
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  adjustments        InventoryAdjustment[]
  feeInvoiceItems    FeeInvoiceItem[]

  @@map("inventory_items")
}

model Client {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  name          String
  abbreviation  String? // for invoice numbering
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  panVat        String?
  crmStatus     ClientStatus @default(ACTIVE)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  salesOrders SalesOrder[]
  quotations  Quotation[]
  creditNotes CreditNote[]

  @@map("clients")
}

model Vendor {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  abbreviation  String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  panVat        String?
  bankDetails   String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchaseOrders PurchaseOrder[]
  inventoryItems InventoryItem[]
  debitNotes     DebitNote[]

  @@map("vendors")
}

model SalesOrder {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id])
  clientName    String
  clientContact String?
  clientAddress String?
  clientPanVat  String?
  dateAd        DateTime
  dateBs        String?
  invoiceNumber String
  laborCharges  Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  isVat         Boolean       @default(false)
  subtotal      Decimal       @db.Decimal(14, 2)
  vatAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  status        OrderStatus   @default(PENDING)
  issuedBy      String? // userId
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    SalesOrderItem[]
  payments Payment[]

  @@unique([companyId, invoiceNumber])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              String         @id @default(uuid())
  salesOrderId    String
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Decimal        @db.Decimal(12, 3)
  unit            String?
  unitPrice       Decimal        @db.Decimal(12, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal        @db.Decimal(14, 2)

  @@map("sales_order_items")
}

model PurchaseOrder {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  vendorId      String?
  vendor        Vendor?       @relation(fields: [vendorId], references: [id])
  vendorName    String
  vendorContact String?
  vendorAddress String?
  vendorPanVat  String?
  dateAd        DateTime
  dateBs        String?
  orderNumber   String
  laborCharges  Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  isVat         Boolean       @default(false)
  subtotal      Decimal       @db.Decimal(14, 2)
  vatAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod PaymentMethod @default(CASH)
  status        OrderStatus   @default(PENDING)
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items    PurchaseOrderItem[]
  payments Payment[]

  @@unique([companyId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Decimal        @db.Decimal(12, 3)
  unit            String?
  unitPrice       Decimal        @db.Decimal(12, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal        @db.Decimal(14, 2)

  @@map("purchase_order_items")
}

model Payment {
  id              String         @id @default(uuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal        @db.Decimal(14, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  dateAd          DateTime
  dateBs          String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("payments")
}

model CreditNote {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id])
  creditNoteNumber String
  salesOrderId     String?
  dateAd           DateTime
  dateBs           String?
  reason           String
  amount           Decimal          @db.Decimal(14, 2)
  status           CreditNoteStatus @default(OPEN)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([companyId, creditNoteNumber])
  @@map("credit_notes")
}

model DebitNote {
  id              String           @id @default(uuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  vendorId        String?
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  debitNoteNumber String
  purchaseOrderId String?
  dateAd          DateTime
  dateBs          String?
  reason          String
  amount          Decimal          @db.Decimal(14, 2)
  status          CreditNoteStatus @default(OPEN)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, debitNoteNumber])
  @@map("debit_notes")
}

model Quotation {
  id              String          @id @default(uuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id])
  clientName      String
  dateAd          DateTime
  dateBs          String?
  quotationNumber String
  items           Json
  description     String?
  laborCharges    Decimal         @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal         @default(0) @db.Decimal(12, 2)
  isVat           Boolean         @default(false)
  subtotal        Decimal         @db.Decimal(14, 2)
  vatAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(14, 2)
  remark          QuotationRemark @default(QUOTED)
  status          QuotationStatus @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([companyId, quotationNumber])
  @@map("quotations")
}

model MemoDocument {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  category        String? // quotation | purchase_bill | sales_bill | job_card | order_slip | extra_work | supporting_doc
  title           String?
  content         String?
  dateAd          DateTime
  dateBs          String?
  documentType    String?
  attachments     Json?
  referenceId     String?
  clientName      String?
  clientContact   String?
  clientAddress   String?
  vendorName      String?
  vendorContact   String?
  vendorPan       String?
  assignedTo      String?
  startDate       DateTime?
  endDate         DateTime?
  deliveryDate    DateTime?
  dueDate         DateTime?
  validUntil      DateTime?
  docType         String?
  linkedReference String?
  description     String?
  amount          Decimal?  @db.Decimal(12, 2)
  documentUrl     String?
  status          String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("memo_documents")
}

model Task {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  title       String
  description String?
  assignedTo  String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

// ─── School Models ───────────────────────────────────────────────────────────

enum FeeFrequency {
  MONTHLY
  TERM
  ANNUAL
}

enum FeeInvoiceStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SchoolEventType {
  GENERAL
  HOLIDAY
  EXAM
  SPORTS
  CULTURAL
  MEETING
}

model SchoolClass {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String // "Grade 1", "Class 10"
  section        String? // "A", "B", "C"
  classTeacherId String? // → Employee.id
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students           Student[]
  feeStructures      FeeStructure[]
  studentAttendances StudentAttendance[]
  timetableEntries   TimetableEntry[]
  studyMaterials     StudyMaterial[]
  homeworks          Homework[]
  examSchedules      ExamSchedule[]
  subjects           SubjectClass[]

  @@unique([companyId, name, section])
  @@map("school_classes")
}

model Student {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  classId       String?
  class         SchoolClass?  @relation(fields: [classId], references: [id])
  name          String
  rollNumber    String?
  examRollNumber String?
  dateOfBirth   DateTime?
  gender        String?
  address       String?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  admissionDate DateTime      @default(now())
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  packageId String?
  package   FeePackage? @relation(fields: [packageId], references: [id])

  feeInvoices          FeeInvoice[]
  examResults          ExamResult[]
  studentAttendances   StudentAttendance[]
  bookIssues           BookIssue[]
  hostelAllocations    HostelAllocation[]
  studentTransports    StudentTransport[]
  portalUsers          PortalUser[]
  scholarships         StudentScholarship[]
  portalNotifications  PortalNotification[]

  @@unique([companyId, rollNumber])
  @@map("students")
}

// Parent/student-portal-facing notifications — separate from the staff
// `Notification` model (that one is keyed to User, portal users aren't Users).
// Free to create — no SMS cost — so this is the "always on" channel; SMS is
// the opt-in-cost channel for the same events (see SchoolFinanceService.billingRun).
model PortalNotification {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title         String
  message       String
  link          String?
  referenceType String?
  referenceId   String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([studentId, isRead])
  @@map("portal_notifications")
}

model Subject {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  code          String?
  bookReference String?
  chapters      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examResults      ExamResult[]
  timetableEntries TimetableEntry[]
  studyMaterials   StudyMaterial[]
  homeworks        Homework[]
  examSchedules    ExamSchedule[]
  classes          SubjectClass[]

  @@unique([companyId, name])
  @@map("subjects")
}

// Links a Subject to the standards/classes it's taught in, so subject pickers
// elsewhere (exams, timetable, homework…) can filter down to the selected class.
model SubjectClass {
  id        String      @id @default(uuid())
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([subjectId, classId])
  @@map("subject_classes")
}

// Catalog of charge types — Tuition, Transport, Hostel, Exam…
// type TRANSPORT/HOSTEL heads bill from the student's actual service assignment.
model FeeHead {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String?
  type      String   @default("GENERAL") // GENERAL | TRANSPORT | HOSTEL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structures   FeeStructure[]
  invoiceItems FeeInvoiceItem[]
  scholarships StudentScholarship[]
  packageHeads FeePackageHead[]

  @@unique([companyId, name])
  @@map("fee_heads")
}

model FeeStructure {
  id        String       @id @default(uuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  classId   String?
  class     SchoolClass? @relation(fields: [classId], references: [id])
  feeHeadId String?
  feeHead   FeeHead?     @relation(fields: [feeHeadId], references: [id])
  name      String // "Tuition Fee", "Exam Fee", "Transport Fee"
  amount    Decimal      @db.Decimal(12, 2)
  frequency FeeFrequency @default(MONTHLY)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("fee_structures")
}

model FeeInvoice {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  month       String // "2081-Bhadra" or "Term 1 2081"
  description String?
  totalAmount Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  discount    Decimal          @default(0) @db.Decimal(12, 2)
  fine        Decimal          @default(0) @db.Decimal(12, 2)
  dueDate     DateTime?
  paidDate    DateTime?
  status      FeeInvoiceStatus @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items    FeeInvoiceItem[]
  payments FeePayment[]

  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         FeeInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHeadId       String?
  feeHead         FeeHead?       @relation(fields: [feeHeadId], references: [id])
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal?       @db.Decimal(12, 3)
  description     String
  amount          Decimal        @db.Decimal(12, 2) // negative = scholarship/discount line

  @@map("fee_invoice_items")
}

// One row per receipt — partial payments each get their own receipt number
model FeePayment {
  id            String       @id @default(uuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  invoiceId     String
  invoice       FeeInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNo     String
  amount        Decimal      @db.Decimal(12, 2)
  method        String       @default("CASH") // CASH | BANK | ESEWA | KHALTI
  bankAccountId String? // set when method = BANK/ESEWA/KHALTI — which bank account this payment settles into
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  paidAt        DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())

  @@unique([companyId, receiptNo])
  @@map("fee_payments")
}

model StudentScholarship {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHeadId String? // null = applies to the whole bill
  feeHead   FeeHead? @relation(fields: [feeHeadId], references: [id])
  name      String // "Dalit Scholarship", "Sibling Discount"
  type      String   @default("PERCENT") // PERCENT | FIXED
  value     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("student_scholarships")
}

// Named bundle of fee heads, optionally at a discounted fixed price
model FeePackage {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String // "Day Scholar", "Full Boarder"
  price     Decimal? @db.Decimal(12, 2) // null = sum of member head amounts
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heads    FeePackageHead[]
  students Student[]

  @@unique([companyId, name])
  @@map("fee_packages")
}

model FeePackageHead {
  id        String     @id @default(uuid())
  packageId String
  package   FeePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feeHeadId String
  feeHead   FeeHead    @relation(fields: [feeHeadId], references: [id])

  @@unique([packageId, feeHeadId])
  @@map("fee_package_heads")
}

model ExamSchedule {
  id         String      @id @default(uuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id])
  classId    String
  class      SchoolClass @relation(fields: [classId], references: [id])
  subjectId  String?
  subject    Subject?    @relation(fields: [subjectId], references: [id])
  examName   String // "First Terminal 2082", "Unit Test 1"
  examDate   DateTime    @db.Date
  startTime  String? // "10:00"
  endTime    String? // "13:00"
  roomNumber String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("exam_schedules")
}

model Exam {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String // "First Terminal", "Second Terminal", "Final"
  examDate  DateTime? @db.Date
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results ExamResult[]

  @@unique([companyId, name])
  @@map("exams")
}

model ExamResult {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  subjectId     String?
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  examId        String?
  exam          Exam?     @relation(fields: [examId], references: [id])
  examName      String
  marksObtained Decimal   @db.Decimal(6, 2)
  totalMarks    Decimal   @db.Decimal(6, 2)
  grade         String?
  remarks       String?
  examDate      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("exam_results")
}

// ─── School Extended Models ──────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String // "2081-82", "2082-83"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentAttendances StudentAttendance[]

  @@unique([companyId, name])
  @@map("academic_years")
}

model StudentAttendance {
  id             String                  @id @default(uuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id])
  studentId      String
  student        Student                 @relation(fields: [studentId], references: [id])
  classId        String
  class          SchoolClass             @relation(fields: [classId], references: [id])
  academicYearId String?
  academicYear   AcademicYear?           @relation(fields: [academicYearId], references: [id])
  date           DateTime                @db.Date
  status         StudentAttendanceStatus @default(PRESENT)
  notes          String?
  createdAt      DateTime                @default(now())

  @@unique([studentId, date])
  @@map("student_attendances")
}

model TimetableEntry {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  classId      String
  class        SchoolClass @relation(fields: [classId], references: [id])
  subjectId    String?
  subject      Subject?    @relation(fields: [subjectId], references: [id])
  teacherId    String?
  dayOfWeek    Int // 0=Sunday,1=Monday,2=Tuesday,3=Wednesday,4=Thursday,5=Friday,6=Saturday
  periodNumber Int
  startTime    String // "09:00"
  endTime      String // "09:45"
  roomNumber   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([classId, dayOfWeek, periodNumber])
  @@map("timetable_entries")
}

model SchoolNotice {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  title          String
  content        String    @db.Text
  targetAudience String    @default("ALL")
  isPublished    Boolean   @default(true)
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("school_notices")
}

model SchoolEvent {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  title       String
  description String?         @db.Text
  startDate   DateTime
  endDate     DateTime?
  eventType   SchoolEventType @default(GENERAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("school_events")
}

// ─── Inventory Adjustment ────────────────────────────────────────────────────

model InventoryAdjustment {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  adjustmentType  String // "ADDITION" | "SUBTRACTION" | "RECOUNT"
  quantityBefore  Decimal       @db.Decimal(12, 3)
  quantityChange  Decimal       @db.Decimal(12, 3) // positive = addition, negative = subtraction
  quantityAfter   Decimal       @db.Decimal(12, 3)
  reason          String?
  adjustedBy      String? // userId
  dateAd          DateTime      @default(now())
  dateBs          String?
  createdAt       DateTime      @default(now())

  @@map("inventory_adjustments")
}

// ─── School Extended: Study Materials, Homework, Library, Hostel, Transport ──

model StudyMaterial {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  classId     String?
  class       SchoolClass? @relation(fields: [classId], references: [id])
  subjectId   String?
  subject     Subject?     @relation(fields: [subjectId], references: [id])
  title       String
  description String?
  fileUrl     String
  fileType    String?
  uploadedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("study_materials")
}

model Homework {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  classId     String
  class       SchoolClass @relation(fields: [classId], references: [id])
  subjectId   String?
  subject     Subject?    @relation(fields: [subjectId], references: [id])
  title       String
  description String?     @db.Text
  dueDate     DateTime
  fileUrl     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("homeworks")
}

model Book {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  title           String
  author          String?
  isbn            String?
  category        String?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  shelfLocation   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookIssues BookIssue[]

  @@map("books")
}

model BookIssue {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id])
  studentId  String?
  student    Student?  @relation(fields: [studentId], references: [id])
  memberName String?
  issueDate  DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  fine       Decimal   @default(0) @db.Decimal(8, 2)
  status     String    @default("ISSUED")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("book_issues")
}

model HostelRoom {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  roomNumber String
  floor      String?
  capacity   Int      @default(4)
  monthlyFee Decimal  @default(0) @db.Decimal(10, 2)
  facilities String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  allocations HostelAllocation[]

  @@unique([companyId, roomNumber])
  @@map("hostel_rooms")
}

model HostelAllocation {
  id        String     @id @default(uuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  roomId    String
  room      HostelRoom @relation(fields: [roomId], references: [id])
  studentId String
  student   Student    @relation(fields: [studentId], references: [id])
  startDate DateTime   @default(now())
  endDate   DateTime?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("hostel_allocations")
}

model TransportRoute {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  routeName     String
  description   String?
  stops         String?
  monthlyFee    Decimal  @default(0) @db.Decimal(10, 2)
  driverName    String?
  vehicleNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studentTransports StudentTransport[]

  @@map("transport_routes")
}

model StudentTransport {
  id         String         @id @default(uuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  routeId    String
  route      TransportRoute @relation(fields: [routeId], references: [id])
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id])
  pickupStop String?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@map("student_transports")
}

model PortalUser {
  id           String         @id @default(uuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id])
  type         PortalUserType @default(PARENT)
  phone        String
  passwordHash String
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([studentId, type])
  @@map("portal_users")
}

model Notification {
  id            String           @id @default(uuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  link          String?
  referenceType String?
  referenceId   String?
  // Structured breakdown of what happened — only populated for SYSTEM_AUTOMATION
  // notifications, so clicking one can show an itemized list instead of just the summary text.
  details       Json?
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, isRead])
  @@index([companyId])
  @@map("notifications")
}

// "Who did what" activity trail — every non-GET API request gets one row here
// (see AuditLogInterceptor). Deliberately has NO foreign-key relations to User/
// Company: the log must survive a user or company being deleted, and it must
// never be able to block a delete elsewhere in the app.
model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  userEmail String?
  userRole  String?
  action    String // CREATE | UPDATE | DELETE
  module    String // e.g. "transactions", "ledger/accounts"
  entityId  String?
  method    String
  path      String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([module, entityId])
  @@index([userId])
  @@map("audit_logs")
}
