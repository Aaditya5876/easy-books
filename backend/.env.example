NODE_ENV=
PORT=

# PostgreSQL
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (BullMQ) — REDIS_PASSWORD only needed for managed/hosted Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Gemini AI — optional, free tier works
GEMINI_API_KEY=

# Sparrow SMS Nepal — optional
SMS_API_KEY=
SMS_SENDER_ID=

# eSewa — optional, blank = auto sandbox mode
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=

# SMTP — for OTP and invite emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=

# Super admin credentials (created on first `prisma db seed` if the email doesn't already exist)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# Khalti — optional, test_ prefix = sandbox mode
KHALTI_SECRET_KEY=
